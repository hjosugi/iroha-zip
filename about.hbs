<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SafeArc third-party licenses</title>
  <style>
    :root { color-scheme: light dark; }
    body { font: 16px/1.5 system-ui, sans-serif; margin: 0; }
    main { margin: 0 auto; max-width: 900px; padding: 2rem; }
    pre { border: 1px solid #8888; max-height: 28rem; overflow: auto; padding: 1rem; white-space: pre-wrap; }
  </style>
</head>
<body>
<main>
  <h1>SafeArc third-party licenses</h1>
  <p>Generated from the dependency graph locked by <code>Cargo.lock</code> using cargo-about 0.9.1.</p>
  <h2>Overview</h2>
  <ul>
    {{#each overview}}
    <li><a href="#{{id}}">{{name}}</a> ({{count}} crates)</li>
    {{/each}}
  </ul>
  <h2>License texts</h2>
  {{#each licenses}}
  <section>
    <h3 id="{{id}}">{{name}}</h3>
    <p>Used by:</p>
    <ul>
      {{#each used_by}}
      <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
  </section>
  {{/each}}
</main>
</body>
</html>
